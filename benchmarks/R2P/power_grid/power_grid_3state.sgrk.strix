(("in:a" & "in:b" & !"in:c") -> (("out:y" & !"out:x" & !"out:z") & (((X "out:y" | X "out:x" | X "out:z") & !(X "out:y" & X "out:x") & !(X "out:y" & X "out:z") & !(X "out:x" & X "out:z") & ("out:x" -> X "out:x") & ("out:z" -> X "out:z")) W !(X "in:a" & (X "in:b" | X "in:c") & !(X "in:b" & X "in:c") & ("in:c" -> X "in:c"))) & (G (X "in:a" & (X "in:b" | X "in:c") & !(X "in:b" & X "in:c") & ("in:c" -> X "in:c")) -> (((GF "in:a" & GF "in:b") -> (FG "out:z")) & ((GF "in:c") -> (FG "out:x"))))))
